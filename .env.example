# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# REQUIRED ≥32 chars. API refuses to start with empty / placeholder / short values.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local-dev-only-replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database (Postgres)
POSTGRES_USER=context
POSTGRES_PASSWORD=context
POSTGRES_DB=context_buyer
POSTGRES_PORT=5432
DATABASE_URL=postgresql://context:context@localhost:5432/context_buyer?schema=public
# If 5432 is already taken locally, use POSTGRES_PORT=5433 and the same port in DATABASE_URL.

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Pipeline queue mode:
#   inline  — sync in-process (local/tests without Redis only)
#   bullmq  — REQUIRED in production with a real REDIS_URL
#   auto    — bullmq when REDIS_URL is set, else inline (OK for local; NEVER use on prod)
# Production MUST set PIPELINE_QUEUE=bullmq and a reachable REDIS_URL.
# Do not rely on auto/inline in production — multi-worker / durable jobs will break.
PIPELINE_QUEUE=auto

# How often to scan OAuth expiry / pipeline failures (ms). 0 disables.
# Runs through the same PIPELINE_QUEUE as other background jobs.
ALERTS_POLL_MS=3600000
# Optional: POST JSON when a critical ops_alert is created
# (platform_rate_limit | oauth_expired | pipeline_failed). Slack/Telegram OK.
# Leave empty to skip (no error).
ALERT_WEBHOOK_URL=

# How often to rotate access tokens before expiry (ms). 0 disables the poller.
# Manual «Обновить токен» still works. Production example: 900000 (15 min).
TOKEN_REFRESH_POLL_MS=0

# AES-256-GCM key for OAuth tokens (Этап 1). REQUIRED: 32 bytes as 64 hex chars OR base64.
# API refuses to start if missing / wrong format (passphrases are not accepted at startup).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Yandex Direct OAuth (Этап 1)
# https://oauth.yandex.ru/ → Redirect URI: http://localhost:3001/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3001/oauth/yandex/callback
YANDEX_OAUTH_SCOPE=direct:api

# Google Ads OAuth (Этап 1 или Этап 6)
# Live (GOOGLE_ADS_MOCK=0): CLIENT_ID, CLIENT_SECRET, DEVELOPER_TOKEN required.
# Redirect must match the Google Cloud OAuth client exactly.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/oauth/google-ads/callback
# Optional MCC / manager account (digits only or with dashes)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Anthropic Claude (Этап 2+). UI «Настройки → ИИ-провайдер» имеет приоритет;
# эта переменная — fallback для локальной разработки и CI.
ANTHROPIC_API_KEY=

# Groq (бесплатный tier для тестов). UI имеет приоритет над env.
GROQ_API_KEY=

# Google Gemini (AI Studio, OpenAI-compatible). UI имеет приоритет над env.
GEMINI_API_KEY=

# Yandex Direct Ads API v5 (Этап 4)
# Production: https://api.direct.yandex.com/json/v5
# Sandbox:    https://api-sandbox.direct.yandex.com/json/v5
YANDEX_DIRECT_API_URL=https://api.direct.yandex.com/json/v5
# 1 = in-memory mock (CI / local without a cabinet)
YANDEX_DIRECT_MOCK=

# 1 = mock Google Ads API + local OAuth callback (no Google network calls)
# 0 = live OAuth (accounts.google.com) + LiveGoogleAdsApi
GOOGLE_ADS_MOCK=1

# 1 = mock Bitrix24 / amoCRM / Calltouch / Roistat (CI / local without CRM)
ATTRIBUTION_MOCK=1

# 1 = mock image/video generation (CI / local without OpenAI)
MEDIA_MOCK=1
# Local directory for generated files (keys: projects/{projectId}/…)
MEDIA_STORE_DIR=
# Live images when MEDIA_MOCK is empty. Prefer the org key in
# «Настройки → ИИ-провайдер»; this env is fallback for local/CI (never logged).
OPENAI_API_KEY=
MEDIA_IMAGE_MODEL=dall-e-3

# How often to pull performance snapshots (ms). 0 disables. Default 1 hour.
PERFORMANCE_POLL_MS=3600000

# How often to sync all campaigns from the ad account (ms). Default 6 hours.
CAMPAIGN_SYNC_MS=21600000

# Min interval between live connection probes on GET /projects/:id (ms). Default 15 min.
CONNECTION_VERIFY_THROTTLE_MS=900000

# How often to re-run optimization + auto-apply on projects with autopilot (ms).
# 0 disables the poller (default). Manual «Построить рекомендации» still applies
# proposed recs when the project toggle is on. Skipped in NODE_ENV=test.
AUTOPILOT_POLL_MS=0

# S3-compatible object storage (экспорт XLSX/CSV, креативы)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Playwright E2E (headless, mocked ads/CRM/media). See README «E2E (Playwright)».
# Copy values into the process via npm run test:e2e / .env.e2e — do not point this
# at a live client cabinet.

