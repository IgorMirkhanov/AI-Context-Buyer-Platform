# Production environment template — copy to a secret store / host env vars.
# Do NOT commit real values. Generate signing keys locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  # TOKEN_ENCRYPTION_KEY
# Or use the gitignored file produced by ops: .env.production.secrets
#
# Replace YOUR_DOMAIN with the public API host (e.g. api.example.com).
# Register the same redirect URIs in oauth.yandex.ru and Google Cloud Console
# BEFORE the first production OAuth attempt.

NODE_ENV=production
API_PORT=3001
WEB_ORIGIN=https://YOUR_DOMAIN
NEXT_PUBLIC_API_URL=https://api.YOUR_DOMAIN

# Images from ghcr (build-images.yml on push to main). Used by infra/docker-compose.prod.yml
# API_IMAGE=ghcr.io/OWNER/REPO/api:latest
# WEB_IMAGE=ghcr.io/OWNER/REPO/web:latest
# For web image rebuilds, set repo Actions variable NEXT_PUBLIC_API_URL to the public API URL.

# REQUIRED — new random values, never copy from local .env
JWT_SECRET=
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=

# Managed Postgres / Redis (not localhost)
DATABASE_URL=postgresql://USER:PASSWORD@PROD_PG_HOST:5432/context_buyer?schema=public&sslmode=require
REDIS_URL=redis://PROD_REDIS_HOST:6379

# Production MUST use BullMQ + reachable Redis
PIPELINE_QUEUE=bullmq

# OAuth redirects — real HTTPS domain (must match console apps exactly)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.YOUR_DOMAIN/oauth/yandex/callback
YANDEX_OAUTH_SCOPE=direct:api
YANDEX_DIRECT_API_URL=https://api.direct.yandex.com/json/v5
YANDEX_DIRECT_MOCK=

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=https://api.YOUR_DOMAIN/oauth/google-ads/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MOCK=0

# Turn mocks OFF when real CRM / media keys are configured
ATTRIBUTION_MOCK=
MEDIA_MOCK=
OPENAI_API_KEY=

# Optional AI fallbacks (prefer org keys in UI)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

TOKEN_REFRESH_POLL_MS=900000
PERFORMANCE_POLL_MS=3600000
CAMPAIGN_SYNC_MS=21600000
CONNECTION_VERIFY_THROTTLE_MS=900000
ALERTS_POLL_MS=3600000
# Optional Slack/Telegram webhook for critical ops_alerts (leave empty to disable)
ALERT_WEBHOOK_URL=
AUTOPILOT_POLL_MS=0
