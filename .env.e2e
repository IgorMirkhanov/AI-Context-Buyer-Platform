# Playwright E2E (dummy secrets, safe to commit).
# Isolated DB: context_buyer_e2e. Local Docker often maps Postgres to 5433.
NODE_ENV=development
API_PORT=3101
WEB_ORIGIN=http://127.0.0.1:3100
JWT_SECRET=e2e-jwt-secret-not-for-production
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://context:context@127.0.0.1:5433/context_buyer_e2e?schema=public
PIPELINE_QUEUE=inline
ALERTS_POLL_MS=0
TOKEN_REFRESH_POLL_MS=0
PERFORMANCE_POLL_MS=0
AUTOPILOT_POLL_MS=0
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
YANDEX_CLIENT_ID=e2e-mock
YANDEX_CLIENT_SECRET=e2e-mock
YANDEX_REDIRECT_URI=http://127.0.0.1:3101/oauth/yandex/callback
YANDEX_DIRECT_MOCK=1
GOOGLE_ADS_MOCK=1
ATTRIBUTION_MOCK=1
MEDIA_MOCK=1
# Fallback so agent run buttons stay enabled; live HTTP is still mocked.
ANTHROPIC_API_KEY=e2e-anthropic-fallback
OPENAI_API_KEY=e2e-openai-fallback
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101
