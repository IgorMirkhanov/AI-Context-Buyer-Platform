# NestJS API loads env from the monorepo root (see apps/api/src/app.module.ts):
#   ../../../../.env  →  <repo>/.env
#
# Do not put secrets here. Copy/edit the root file instead:
#   cp .env.example .env
#
# Required Google Ads keys (root .env):
#   GOOGLE_ADS_CLIENT_ID
#   GOOGLE_ADS_CLIENT_SECRET
#   GOOGLE_ADS_DEVELOPER_TOKEN
#   GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/oauth/google-ads/callback
#   GOOGLE_ADS_LOGIN_CUSTOMER_ID   (optional MCC)
#   GOOGLE_ADS_MOCK=1              (local/CI without Google) or 0 (live OAuth + API)
